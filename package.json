{
  "name": "zhixing-study",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "知行学习 · 知行学习题库，支持 GitHub Pages 与可选的进度同步后端",
  "scripts": {
    "dev": "python3 server.py",
    "build": "python3 scripts/build_static.py",
    "verify": "python3 scripts/verify_site.py",
    "check:bank": "python3 scripts/check_bank.py",
    "test": "node --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:browser": "node scripts/run_browser_tests.mjs",
    "index:bank": "python3 scripts/index_knowledge.py && python3 scripts/index_pdf_bank.py"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
